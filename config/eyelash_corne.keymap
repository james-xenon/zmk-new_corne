#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp RALT>, <&mo 4>;
        };

        vol_up2: vol_up2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C_VOLUME_UP &kp C_VOLUME_UP>;
        };

        vol_down2: vol_down2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C_VOLUME_DOWN &kp C_VOLUME_DOWN>;
        };
    };

    volume_encoder: volume_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&vol_up2>, <&vol_down2>;
        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        // F + D → NAV
        combo_fd_nav {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mo 1>;
            layers = <0>;
        };

        // new_behavior + mo 2 → SERVICE
        combo_service {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mo 5>;
            layers = <0>;
        };

        combo_jk_backspace {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp BSPC>;
            layers = <0 1 2 3 4 5>;
        };

        combo_kl_delete {
            timeout-ms = <50>;
            key-positions = <24 25>;
            bindings = <&kp DEL>;
            layers = <0 1 2 3 4 5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E          &kp R  &kp T                               &kp UP                 &kp Y        &kp U  &kp I      &kp O    &kp P     &kp LBKT
&td0       &kp A  &kp S  &kp D          &kp F  &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT   &kp H        &kp J  &kp K      &kp L    &kp SEMI  &mt LSHFT SQT
&kp LCTRL  &kp Z  &kp X  &kp C          &kp V  &kp B        &kp C_MUTE             &kp DOWN               &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                         &new_behavior  &mo 2  &kp SPC                                                    &mt LGUI ENTER  &mo 3  &kp LG(SPC)
            >;

            sensor-bindings = <&volume_encoder>;
        };

        nav_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans             &trans          &mkp LCLK  &kp UP     &mkp RCLK  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans             &trans    &trans  &trans     &msc SCRL_DOWN  &kp LEFT   &kp DOWN   &kp RIGHT  &msc SCRL_UP  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans               &trans             &trans          &trans     &mkp MCLK  &trans     &trans        &trans
                        &trans  &trans  &trans                                          &trans          &trans     &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        symb_layer {
            bindings = <
&trans  &kp EXCL         &kp AT            &kp HASH     &kp DLLR   &kp PRCNT                            &mmv MOVE_UP                   &kp CARET         &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp BSPC
&trans  &kp SLASH        &mkp LCLK         &mkp MCLK    &mkp RCLK  &mkp MB4             &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT    &kp MINUS         &kp LBKT   &kp RBKT   &kp RBKT   &kp BSLH   &kp GRAVE
&trans  &out OUT_USB     &out OUT_BLE      &trans       &trans     &mkp MB5   &trans                    &mmv MOVE_DOWN                &kp UNDER         &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
                                           &trans       &trans     &kp SPC                                                            &kp RET           &trans     &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        numb_layer {
            bindings = <
&kp ESC  &trans  &trans  &trans  &trans  &trans                                   &msc SCRL_UP                     &trans           &kp N7    &kp N8    &kp N9    &trans    &kp BSPC
&trans   &trans  &trans  &trans  &trans  &trans                 &msc SCRL_LEFT    &mkp LCLK     &msc SCRL_RIGHT    &kp ENTER        &kp N4    &kp N5    &kp N6    &kp N0    &kp PG_UP
&trans   &trans  &trans  &trans  &trans  &trans   &kp C_MUTE                      &msc SCRL_DOWN                   &trans           &kp N1    &kp N2    &kp N3    &kp END   &kp PG_DN
                         &trans  &trans  &trans                                                                    &kp INS          &trans    &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        fn_layer {
            bindings = <
&kp ESC     &kp F1       &kp F2     &kp F3      &kp F4      &kp F5                                     &mmv MOVE_UP                       &kp F6        &kp F7     &kp F8      &kp F9     &kp F10     &kp F11
&trans      &trans       &trans     &trans      &trans      &mkp MB4                 &mmv MOVE_LEFT    &mkp LCLK       &mmv MOVE_RIGHT    &trans        &trans     &trans      &trans     &trans      &kp F12
&trans      &trans       &trans     &trans      &trans      &mkp MB5   &kp C_MUTE                      &mmv MOVE_DOWN                     &trans        &trans     &trans      &trans     &trans      &trans
                                    &trans      &trans      &trans                                                                        &trans        &trans     &trans
            >;

            sensor-bindings = <&volume_encoder>;
        };

        service_layer {
            bindings = <
&kp ESC  &trans  &trans  &trans    &trans           &studio_unlock                           &trans                   &bt BT_CLR_ALL    &trans           &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2         &bt BT_SEL 3
&trans   &trans  &trans  &trans    &trans           &trans                           &trans  &trans    &trans         &trans            &trans           &trans            &trans            &trans               &trans
&trans   &trans  &trans  &trans    &trans           &trans    &kp C_MUTE                     &trans                   &rgb_ug RGB_EFR   &rgb_ug RGB_EFF  &rgb_ug RGB_SPI   &rgb_ug RGB_SPD   &rgb_ug RGB_BRI      &rgb_ug RGB_BRD
                         &trans    &trans           &trans                                                            &rgb_ug RGB_ON    &trans           &rgb_ug RGB_OFF
            >;

            sensor-bindings = <&volume_encoder>;
        };
    };
};
