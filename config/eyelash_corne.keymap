#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/ws2812_widget.dtsi>
#include <behaviors/ws2812_layer_sync.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&led_strip {
    chain-length = <42>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    chosen {
        zmk,ws2812-widget = &led_strip;
    };

    behaviors {

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        tab_esc_ht: tab_esc_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Win thumb: удержание = mo 2, двойной = LGUI
        symb_win_td: symb_win_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mo 2>, <&kp LGUI>;
        };

        numb_symb_td: numb_symb_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&tog 2>, <&tog 3>;
        };

        thumb_num_sym_fn: thumb_num_sym_fn {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&numb_symb_td>;
        };

        lang_nav2: lang_nav2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&win_space>;
        };

        nav2_double_tap: nav2_double_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&trans>, <&tog 6>;
        };

        speedtype_double_tap: speedtype_double_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&trans>, <&tog 11>;
        };

        kp_once: kp_once {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1 &macro_press &kp 0>,
                       <&macro_param_1to1 &macro_release &kp 0>;
        };

        edit_ht: edit_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp_once>, <&kp>;
        };

        media_ht: media_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        // Alt на З: tap=N, hold=LALT
        n_alt_ht: n_alt_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        semi_fn_ht: semi_fn_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lh_td: lh_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&trans>, <&kp LALT>;
        };

        // Левая нижняя: double tap=LALT, hold=mo 14
        lefthand_ht: lefthand_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&lh_td>;
        };

        screenshot_win_shift_s: screenshot_win_shift_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <30>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_press &kp LSHIFT>,
                <&macro_tap &kp S>,
                <&macro_release &kp LSHIFT>,
                <&macro_release &kp LGUI>;
        };

        lbkt_screenshot: lbkt_screenshot {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&screenshot_win_shift_s>, <&kp>;
        };

        win_space: win_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_tap &kp SPACE>,
                <&macro_release &kp LGUI>;
        };

        // Включение слоя 13 — белая индикация (ws2812_lsync param=1 = ON цвет)
        tog13_on: tog13_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog 13>, <&ws2812_lsync 1>;
        };

        // Выключение слоя 13 — красная индикация (ws2812_lsync param=0 = OFF цвет)
        tog13_off: tog13_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog 13>, <&ws2812_lsync 0>;
        };

        // Toggle macro: вызывает &tog 13 (используется для double-tap combo)
        toggle13: toggle13 {
            compatible = "james,toggle-layer13";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&tog 13>;
        };

        // tap-dance: одиночный = ничего, двойной = toggle13 (двойной тап Q+W переключает слой)
        tog13_td: tog13_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&trans>, <&toggle13>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_wert_gaming_toggle {
            timeout-ms = <120>;
            require-prior-idle-ms = <250>;
            key-positions = <2 3 4 5>;
            bindings = <&tog 7>;
            layers = <0 7>;
        };

        // Q(1)+W(2) double-tap: toggles layer 13 (double tap on either layer)
        combo_qw_tog13 {
            timeout-ms = <60>;
            require-prior-idle-ms = <150>;
            key-positions = <1 2>;
            bindings = <&tog13_td>;
            layers = <0 13>;
        };

        combo_er_nav3 {
            timeout-ms = <50>;
            key-positions = <3 4>;
            bindings = <&mo 10>;
            layers = <0>;
        };

        combo_sqt_esc_speedtype {
            timeout-ms = <70>;
            key-positions = <27 41>;
            bindings = <&speedtype_double_tap>;
            layers = <0 11>;
        };

        combo_fd_nav {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mo 1>;
            layers = <0 11>;
        };

        combo_service {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mo 5>;
            layers = <0>;
        };

        combo_yu_nav2_double_tap {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&nav2_double_tap>;
            layers = <0 1 2 3 4 5 6 11>;
        };

        combo_jk_backspace {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp BSPC>;
            layers = <0 1 2 3 4 5 6 11>;
        };

        combo_kl_delete {
            timeout-ms = <50>;
            key-positions = <24 25>;
            bindings = <&kp DEL>;
            layers = <0 1 2 3 4 5 6 11>;
        };

        // DOWN(16) + RIGHT(17) = BSPC — только слои 13 и 14
        combo_lh_bspc {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
            layers = <13 14>;
        };

        // LEFT(15) + DOWN(16) = DEL — только слои 13 и 14
        combo_lh_del {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp DEL>;
            layers = <13 14>;
        };

        // ==========================================
        // НОВЫЕ КОМБО для левой центральной половины
        // ==========================================
        
        // Комбо Backspace для левой центральной половины
        // symb_layer (2): TILDE (16) + AMPS (17)
        // numb_layer (3): N5 (16) + N4 (17)
        // fn_layer (4), nav2_layer (6), nav2nolight_layer (12): физически те же позиции
        combo_left_center_bspc {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
            layers = <2 3 4 6 12>;
        };

        // Комбо Delete для левой центральной половины
        // symb_layer (2): BSLH (15) + TILDE (16)
        // numb_layer (3): N6 (15) + N5 (16)
        // fn_layer (4), nav2_layer (6), nav2nolight_layer (12): физически те же позиции
        combo_left_center_del {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp DEL>;
            layers = <2 3 4 6 12>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB      &kp Q             &kp W             &kp E                &kp R             &kp T                         &kp UP                &media_ht C_PP Y    &media_ht C_PREV U     &media_ht C_NEXT I  &media_ht C_STOP O  &kp P               &lbkt_screenshot 0 LBKT
&td0         &edit_ht LC(A) A  &edit_ht LC(S) S  &kp D                &edit_ht LC(F) F  &kp G               &kp LEFT  &kp SPC   &kp RIGHT   &kp H               &kp J                  &kp K               &kp L               &semi_fn_ht 4 SEMI  &mt LSHFT SQT
&kp LCTRL    &edit_ht LC(Z) Z  &edit_ht LC(X) X  &edit_ht LC(C) C     &edit_ht LC(V) V  &kp B   &kp C_MUTE            &kp DOWN              &n_alt_ht LALT N    &kp M                  &kp COMMA           &kp DOT             &kp FSLH            &kp ESC
                                                 &lefthand_ht 14 0    &symb_win_td      &kp SPC                                             &kp ENTER           &thumb_num_sym_fn 3 0  &lang_nav2 12 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nav1_layer {
            bindings = <
&kp ESC  &none  &none  &none  &none  &none                               &mmv MOVE_UP                       &kp HOME          &mkp LCLK          &kp UP     &mkp RCLK            &kp COMMA       &kp BSPC
&none   &none   &none  &none  &none  &none               &mmv MOVE_LEFT  &mkp LCLK      &mmv MOVE_RIGHT     &msc SCRL_DOWN    &kp LEFT           &kp DOWN   &kp RIGHT            &msc SCRL_UP    &kp PG_UP
&none   &none   &none  &none  &none  &none       &trans                  &mmv MOVE_DOWN                     &kp END           &msc MOVE_Y(-100)  &mkp MCLK  &msc MOVE_Y(100)     &kp DOT         &kp PG_DN
                       &trans &trans &trans                                                                 &trans            &trans             &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        symb_layer {
            bindings = <
&kp ESC &kp EXCL  &kp AT    &kp HASH  &kp DLLR   &kp PRCNT                               &kp UP                   &kp EXCL   &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp HASH
&trans  &kp BSLH  &kp BSLH  &kp TILDE &kp AMPS   &mkp MB4                      &kp LEFT  &kp SPC    &kp RIGHT     &kp AT     &kp RBKT   &kp LBKT   &kp CARET  &kp BSLH   &kp DLLR
&trans  &kp PIPE  &kp LBRC  &kp RBRC  &kp GRAVE  &mkp MB5   &trans                       &kp DOWN                 &kp UNDER  &kp MINUS  &kp PLUS   &kp EQUAL  &kp PIPE   &kp PRCNT
                            &trans    &trans     &kp SPC                                                          &kp ENTER  &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        numb_layer {
            bindings = <
&kp ESC   &kp COMMA  &kp N9  &kp N8  &kp N7  &kp C_AL_CALCULATOR                                 &msc SCRL_UP                       &kp HOME   &kp N7  &kp N8  &kp N9  &kp COMMA  &kp BSPC
&kp PG_UP &kp N0     &kp N6  &kp N5  &kp N4  &mkp MB4                          &msc SCRL_LEFT    &mkp LCLK       &msc SCRL_RIGHT    &kp QMARK  &kp N4  &kp N5  &kp N6  &kp N0     &kp PG_UP
&kp PG_DN &kp DOT    &kp N3  &kp N2  &kp N1  &mkp MB5             &kp C_MUTE                     &msc SCRL_DOWN                     &kp END    &kp N1  &kp N2  &kp N3  &kp DOT    &kp PG_DN
                             &trans  &trans  &trans                                                                                 &kp INS    &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        fn_layer {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                     &mmv MOVE_UP                       &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&none    &none   &none   &none   &none   &mkp MB4                 &mmv MOVE_LEFT    &mkp LCLK       &mmv MOVE_RIGHT    &trans  &kp F4  &kp F5  &kp F6  &none    &kp F12
&none    &none   &none   &none   &none   &mkp MB5  &kp C_MUTE                       &mmv MOVE_DOWN                     &trans  &kp F1  &kp F2  &kp F3  &none    &kp ESC
                         &trans  &trans  &trans                                                                        &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        service_layer {
            bindings = <
&kp ESC         &none   &none         &none          &mkp RCLK      &studio_unlock                        &trans              &bt BT_CLR      &none           &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3
&none           &none   &none         &ws2812_wdg 5  &ws2812_wdg 2  &out OUT_BLE                  &trans  &trans  &trans      &none           &none           &none           &none           &none            &none
&bt BT_CLR_ALL  &none   &none         &none          &none          &out OUT_USB    &kp C_MUTE            &trans              &rgb_ug RGB_EFR &rgb_ug RGB_EFF &rgb_ug RGB_SPI &rgb_ug RGB_SPD &rgb_ug RGB_BRI  &rgb_ug RGB_BRD
                                      &trans         &trans         &trans                                                    &rgb_ug RGB_ON  &trans          &rgb_ug RGB_OFF
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nav2_layer {
            bindings = <
&kp ESC &trans  &trans  &trans  &trans  &trans                      &trans              &trans  &trans  &trans   &trans    &kp DEL   &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans      &trans  &trans  &kp SPC  &kp ESC   &kp UP    &kp ENTER
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE          &trans              &trans  &trans  &trans   &kp LEFT  &kp DOWN  &kp RIGHT
                        &trans  &trans  &trans                                          &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        gaming1_layer {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E   &kp R   &kp T                        &kp UP                  &kp Y      &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D   &kp F   &kp G              &kp LEFT  &kp ENTER  &kp RIGHT    &kp H      &kp J   &kp K      &kp L    &kp SEMI  &none
&kp LCTRL  &kp Z  &kp X  &kp C   &kp V   &kp B       &none            &kp DOWN                &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &none
                         &mo 9   &mo 8   &kp SPACE                                            &kp ENTER  &none   &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        gaming2_layer {
            bindings = <
&kp ESC  &kp N1  &kp N9  &kp N8  &kp N7   &kp N5                &none          &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &none
&kp L    &kp N6  &kp N6  &kp N5  &kp N4   &kp I          &none  &none  &none   &kp F8  &none   &none   &none   &none   &none
&kp U    &kp L   &kp N3  &kp N2  &kp N1   &kp J   &none         &none          &kp F9  &none   &none   &none   &none   &none
                         &none   &none    &none                                &none   &none   &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        gaming3_layer {
            bindings = <
&none  &kp P  &kp O  &kp I  &kp U  &kp Y                   &none          &none  &none  &none  &none  &none  &none
&none  &none  &kp L  &kp K  &kp J  &kp H           &kp A   &none  &none   &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &kp M  &kp N   &none           &none          &none  &none  &none  &none  &none  &none
                     &none  &none  &none                                  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nav3_layer {
            bindings = <
&kp ESC &none   &none   &none   &none   &none                          &kp UP                   &kp HOME        &mkp LCLK            &mmv MOVE_UP    &mkp RCLK          &kp COMMA      &kp BSPC
&none   &none   &none   &none   &none   &none                &kp LEFT  &kp ENTER  &kp RIGHT     &msc SCRL_DOWN  &mmv MOVE_LEFT       &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &msc SCRL_UP   &kp PG_UP
&none   &none   &trans  &none   &none   &none   &kp C_MUTE             &kp DOWN                 &kp END         &msc MOVE_Y(-100)    &mkp MCLK       &msc MOVE_Y(100)   &kp DOT        &kp PG_DN
                        &trans  &trans  &trans                                                  &trans          &trans               &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        speedtype {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R          &kp T                               &kp UP                 &kp Y      &kp U                  &kp I              &kp O       &kp P     &kp LBKT
&kp LSHFT  &kp A  &kp S  &kp D      &kp F          &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT   &kp H      &kp J                  &kp K              &kp L       &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V          &kp B      &kp C_MUTE               &kp DOWN               &kp N      &kp M                  &kp COMMA          &kp DOT     &kp FSLH  &kp ESC
                         &kp RALT   &symb_win_td   &kp SPC                                                    &kp ENTER  &thumb_num_sym_fn 3 0  &lang_nav2 12 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        nav2nolight_layer {
            bindings = <
&kp ESC &trans  &trans  &trans  &trans  &trans                      &trans          &trans  &trans  &trans  &trans    &kp DEL   &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &kp SPC &kp ESC   &kp UP    &kp ENTER
&trans  &trans  &trans  &trans  &trans  &trans  &kp C_MUTE          &trans          &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT
                        &trans  &trans  &trans                                      &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        lefthand_layer {
            bindings = <
&tab_esc_ht ESC TAB  &trans    &kp ENTER    &kp UP       &kp SPC    &kp HOME                       &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans               &trans    &kp LEFT     &kp DOWN     &kp RIGHT  &kp END                &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans               &kp EXCL  &kp AMPS     &kp COMMA    &kp DOT    &trans     &trans              &trans            &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans       &trans     &trans                                           &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        lefthandnolight_layer {
            bindings = <
&tab_esc_ht ESC TAB  &trans    &kp ENTER    &kp UP       &kp SPC    &kp HOME                       &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans               &trans    &kp LEFT     &kp DOWN     &kp RIGHT  &kp END                &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans               &kp EXCL  &kp AMPS     &kp COMMA    &kp DOT    &trans     &trans              &trans            &trans  &trans  &trans  &trans  &trans  &trans
                                            &trans       &trans     &trans                                           &trans  &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
    };
};
