            bindings = <
&kp TAB    &kp Q  &kp W  &kp E      &kp R              &t_yo_ht GRAVE T                    &kp UP                 &kp Y      &kp U                   &kp I              &kp O       &kp P     &kp LBKT
&kp LSHFT  &kp A  &kp S  &kp D      &kp F              &kp G                     &kp LEFT  &kp ENTER  &kp RIGHT   &kp H      &kp J                   &kp K              &kp L       &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V              &kp B      &kp C_MUTE               &kp DOWN               &kp N      &kp M                   &kp COMMA          &kp DOT     &kp FSLH  &kp ESC
                         &kp RALT   &symb_win_td 17 0  &kp SPC                                                    &kp ENTER  &thumb_num_sym_fn 15 0  &lang_nav2 12 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
        nav2nolight_layer {
            display-name = "nav2nolight_layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans              &trans  &kp HOME  &kp PG_UP  &kp ESC    &kp DEL   &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans      &trans  &kp END   &kp PG_DN  &kp ENTER  &kp UP    &kp SPC
&trans  &trans  &trans  &trans  &trans  &trans  &trans              &trans              &trans  &trans    &kp LSHFT  &kp LEFT   &kp DOWN  &kp RIGHT
                        &trans  &trans  &trans                                          &trans  &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
        lefthand_layer {
            display-name = "lefthand_layer";
            bindings = <
&kp TAB       &kp HOME            &kp ENTER            &kp UP          &kp SPC            &mkp MB5                                      &kp UP                  &kp LG(SEMI)            &kp LG(UP)      &kp LG(DOWN)     &kp LG(C)      &kp LG(TAB)        &kp KP_NUM
&kp LSHFT     &kp END             &kp LEFT             &kp DOWN        &kp RIGHT          &mkp MB4                            &kp LEFT  &kp ENTER  &kp RIGHT    &kp C_AC_SEARCH         &kp F2          &kp LC(LS(N))    &kp LC(P)      &kp LC(LS(ESC))    &kp SLCK
&kp LCTRL     &kp LC(LS(T))       &kp LC(LS(TAB))      &kp LC(R)       &kp LC(TAB)        &kp LC(W)    &kp C_MUTE                       &kp DOWN                &kp LG(E)               &kp LG(LEFT)    &kp LG(RIGHT)    &kp LG(H)      &kp LG(L)          &kp LG(D)
                                                       &trans          &trans             &trans                                                                &trans                  &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
        lefthandnolight_layer {
            display-name = "lefthandnolight_layer";
            bindings = <
&alt_tab      &kp HOME            &kp ENTER            &kp UP          &kp SPC            &mkp MB5                                      &kp UP                  &kp LG(SEMI)            &kp LG(UP)      &kp LG(DOWN)     &kp LG(C)      &kp LG(TAB)        &kp KP_NUM
&kp LSHFT     &kp END             &kp LEFT             &kp DOWN        &kp RIGHT          &mkp MB4                            &kp LEFT  &kp ENTER  &kp RIGHT    &kp C_AC_SEARCH         &kp F2          &kp LC(LS(N))    &kp LC(P)      &kp LC(LS(ESC))    &kp SLCK
&kp LCTRL     &kp LC(LS(T))       &kp LC(LS(TAB))      &kp LC(R)       &kp LC(TAB)        &kp LC(W)    &kp C_MUTE                       &kp DOWN                &kp LG(E)               &kp LG(LEFT)    &kp LG(RIGHT)    &kp LG(H)      &kp LG(L)          &kp LG(D)
                                                       &trans          &trans             &trans                                                                &trans                  &trans          &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
        numbnolight_layer {
            display-name = "numbnolight_layer";
            bindings = <
&kp C_AL_CALCULATOR   &kp KP_MULTIPLY                  &kp N9  &kp N8  &kp N7  &kp KP_PLUS                                            &msc SCRL_UP                      &kp KP_PLUS     &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY                  &kp C_AL_CALCULATOR
&kp BSPC              &kp N0                           &kp N6  &kp N5  &kp N4  &kp KP_MINUS                          &msc SCRL_LEFT   &mkp LCLK       &msc SCRL_RIGHT   &kp KP_MINUS    &kp N4  &kp N5  &kp N6  &kp N0                           &bspc_to_layer_ht 16 BSPC
&kp KP_ENTER          &div_lshft_ht LSHFT KP_DIVIDE    &kp N3  &kp N2  &kp N1  &kp KP_EQUAL    &trans                                 &msc SCRL_DOWN                    &kp KP_EQUAL    &kp N1  &kp N2  &kp N3  &div_lshft_ht LSHFT KP_DIVIDE    &kp KP_ENTER
                                                               &trans  &trans  &trans                                                                                   &kp ENTER       &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
        symbnolightcopy_layer {
            display-name = "symbnolightcopy_layer";
            bindings = <
&hash_dollar_ht DLLR HASH       &rpar_rbrc_ht RBRC RPAR       &lpar_lbrc_ht LBRC LPAR        &astrk_caret_ht CARET ASTRK    &qmark_dqt_ht 0 0       &excl_tilde_ht TILDE EXCL                              &kp UP                 &excl_tilde_ht TILDE EXCL     &qmark_dqt_ht 0 0            &astrk_caret_ht CARET ASTRK  &lpar_lbrc_ht LBRC LPAR      &rpar_rbrc_ht RBRC RPAR       &hash_dollar_ht DLLR HASH
&bspc_to_numb_ht 18 FSLH        &semi_rbrc_ht 0 0             &comma_lbrc_ht LBRC COMMA      &dot_lbkt_ht LBKT DOT          &rbkt_sqt_ht SQT RBKT   &colon_at_ht AT COLON                        &kp LEFT  &kp SPC   &kp RIGHT    &colon_at_ht AT COLON         &rbkt_sqt_ht SQT RBKT        &dot_lbkt_ht LBKT DOT        &comma_lbrc_ht LBRC COMMA    &semi_rbrc_ht 0 0             &slash_bslh_ht BSLH SLASH
&dqt_pipe_ht PIPE 0             &percent_amp_ht PRCNT AMPS    &equal_tilde_ht TILDE EQUAL    &plus_gt_ht GT PLUS            &minus_lt_ht LT MINUS   &under_lshft_ht LSHFT UNDER     &trans                 &kp DOWN               &under_lshft_ht LSHFT UNDER   &minus_lt_ht LT MINUS        &plus_gt_ht GT PLUS          &equal_tilde_ht TILDE EQUAL  &percent_amp_ht PRCNT AMPS    &dqt_pipe_ht PIPE 0
                                                                                             &trans                         &trans                  &kp SPC                                                                       &kp ENTER                     &trans                       &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
        symbnolight_layer {
            display-name = "symbnolight_layer";
            bindings = <
&hash_dollar_ht DLLR HASH       &rpar_rbrc_ht RBRC RPAR       &lpar_lbrc_ht LBRC LPAR        &astrk_caret_ht CARET ASTRK    &qmark_dqt_ht 0 0       &excl_tilde_ht TILDE EXCL                              &kp UP                 &excl_tilde_ht TILDE EXCL     &qmark_dqt_ht 0 0            &astrk_caret_ht CARET ASTRK  &lpar_lbrc_ht LBRC LPAR      &rpar_rbrc_ht RBRC RPAR       &hash_dollar_ht DLLR HASH
&bspc_to_numb_ht 18 FSLH        &semi_rbrc_ht 0 0             &comma_lbrc_ht LBRC COMMA      &dot_lbkt_ht LBKT DOT          &rbkt_sqt_ht SQT RBKT   &colon_at_ht AT COLON                        &kp LEFT  &kp SPC   &kp RIGHT    &colon_at_ht AT COLON         &rbkt_sqt_ht SQT RBKT        &dot_lbkt_ht LBKT DOT        &comma_lbrc_ht LBRC COMMA    &semi_rbrc_ht 0 0             &slash_bslh_ht BSLH SLASH
&dqt_pipe_ht PIPE 0             &percent_amp_ht PRCNT AMPS    &equal_tilde_ht TILDE EQUAL    &plus_gt_ht GT PLUS            &minus_lt_ht LT MINUS   &under_lshft_ht LSHFT UNDER     &trans                 &kp DOWN               &under_lshft_ht LSHFT UNDER   &minus_lt_ht LT MINUS        &plus_gt_ht GT PLUS          &equal_tilde_ht TILDE EQUAL  &percent_amp_ht PRCNT AMPS    &dqt_pipe_ht PIPE 0
                                                                                             &trans                         &trans                  &kp SPC                                                                       &kp ENTER                     &trans                       &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
        numbnolightcopy_layer {
            display-name = "numbnolightcopy_layer";
            bindings = <
&kp C_AL_CALCULATOR   &kp KP_MULTIPLY                  &kp N9  &kp N8  &kp N7  &kp KP_PLUS                                      &msc SCRL_UP                       &kp KP_PLUS    &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY                  &kp C_AL_CALCULATOR
&kp BSPC              &kp N0                           &kp N6  &kp N5  &kp N4  &kp KP_MINUS                   &msc SCRL_LEFT    &mkp LCLK       &msc SCRL_RIGHT    &kp KP_MINUS   &kp N4  &kp N5  &kp N6  &kp N0                           &kp BSPC
&kp KP_ENTER          &div_lshft_ht LSHFT KP_DIVIDE    &kp N3  &kp N2  &kp N1  &kp KP_EQUAL    &trans                           &msc SCRL_DOWN                     &kp KP_EQUAL   &kp N1  &kp N2  &kp N3  &div_lshft_ht LSHFT KP_DIVIDE    &kp KP_ENTER
                                                               &trans  &trans  &trans                                                                              &kp ENTER      &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // ============================================================
        // НОВЫЕ СЛОИ ДЛЯ СТАНДАРТНОГО ZMK-ВВОДА (БЕЗ ALT)
        // ============================================================
        
        // Слой 19: Маршрутизатор (Router Layer). Включается по макросу &tog_std_sym
        // Заменяет кнопки на больших пальцах, перенаправляя их на новые стандартные слои
        symb_router_layer {
            display-name = "symb_router_layer";
            bindings = <
&trans &trans &trans &trans &trans &trans                           &trans                   &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                 &trans    &trans    &trans         &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans       &trans              &trans                   &trans &trans &trans &trans &trans &trans
                            &trans &symb_win_td_std 21 0 &trans                              &trans &thumb_num_sym_fn 23 0 &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // Слой 20: Стандартные символы с постоянной подсветкой
        symb_std_layer {
            display-name = "symb_std_layer";
            bindings = <
&sym_ht DLLR HASH        &sym_ht RBRC RPAR    &sym_ht LBRC LPAR         &sym_ht CARET ASTRK  &sym_ht AMPS QMARK   &sym_ht TILDE EXCL                             &kp UP                 &sym_ht TILDE EXCL           &sym_ht AMPS QMARK     &sym_ht CARET ASTRK  &sym_ht LBRC LPAR         &sym_ht RBRC RPAR    &sym_ht DLLR HASH
&bspc_to_numb_ht 21 FSLH &sym_ht GRAVE SEMI   &std_comma_deg_ht 0 COMMA &sym_ht LBKT DOT     &sym_ht SQT RBKT     &sym_ht AT COLON                     &kp LEFT  &kp SPC   &kp RIGHT    &sym_ht AT COLON             &sym_ht SQT RBKT       &sym_ht LBKT DOT     &std_comma_deg_ht 0 COMMA &sym_ht GRAVE SEMI   &sym_ht BSLH FSLH
&sym_ht PIPE PRCNT       &kp DQT              &kp EQUAL                 &sym_ht GT PLUS      &sym_ht LT MINUS     &std_under_emdash_ht 0 UNDER &trans            &kp DOWN               &std_under_emdash_ht 0 UNDER &sym_ht LT MINUS       &sym_ht GT PLUS      &kp EQUAL                 &kp DQT              &sym_ht PIPE PRCNT
                                                                        &trans               &trans               &kp SPC                                                               &kp ENTER                    &trans                 &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        // Слой 21: Стандартные символы без подсветки (вызывается левым пальцем)
        symbnolight_std_layer {
            display-name = "symbnolight_std_layer";
            bindings = <
&sym_ht DLLR HASH        &sym_ht RBRC RPAR    &sym_ht LBRC LPAR         &sym_ht CARET ASTRK  &sym_ht AMPS QMARK   &sym_ht TILDE EXCL                             &kp UP                 &sym_ht TILDE EXCL           &sym_ht AMPS QMARK     &sym_ht CARET ASTRK  &sym_ht LBRC LPAR         &sym_ht RBRC RPAR    &sym_ht DLLR HASH
&bspc_to_numb_ht 18 FSLH &sym_ht GRAVE SEMI   &std_comma_deg_ht 0 COMMA &sym_ht LBKT DOT     &sym_ht SQT RBKT     &sym_ht AT COLON                     &kp LEFT  &kp SPC   &kp RIGHT    &sym_ht AT COLON             &sym_ht SQT RBKT       &sym_ht LBKT DOT     &std_comma_deg_ht 0 COMMA &sym_ht GRAVE SEMI   &sym_ht BSLH FSLH
&sym_ht PIPE PRCNT       &kp DQT              &kp EQUAL                 &sym_ht GT PLUS      &sym_ht LT MINUS     &std_under_emdash_ht 0 UNDER &trans            &kp DOWN               &std_under_emdash_ht 0 UNDER &sym_ht LT MINUS       &sym_ht GT PLUS      &kp EQUAL                 &kp DQT              &sym_ht PIPE PRCNT
                                                                        &trans               &trans               &kp SPC                                                               &kp ENTER                    &trans                 &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // Слой 22: Копия стандартных символов без подсветки (вызывается правым пальцем через слой цифр)
        symbnolightcopy_std_layer {
            display-name = "symbnolightcopy_std_layer";
            bindings = <
&sym_ht DLLR HASH        &sym_ht RBRC RPAR    &sym_ht LBRC LPAR         &sym_ht CARET ASTRK  &sym_ht AMPS QMARK   &sym_ht TILDE EXCL                             &kp UP                 &sym_ht TILDE EXCL           &sym_ht AMPS QMARK     &sym_ht CARET ASTRK  &sym_ht LBRC LPAR         &sym_ht RBRC RPAR    &sym_ht DLLR HASH
&bspc_to_numb_ht 18 FSLH &sym_ht GRAVE SEMI   &std_comma_deg_ht 0 COMMA &sym_ht LBKT DOT     &sym_ht SQT RBKT     &sym_ht AT COLON                     &kp LEFT  &kp SPC   &kp RIGHT    &sym_ht AT COLON             &sym_ht SQT RBKT       &sym_ht LBKT DOT     &std_comma_deg_ht 0 COMMA &sym_ht GRAVE SEMI   &sym_ht BSLH FSLH
&sym_ht PIPE PRCNT       &kp DQT              &kp EQUAL                 &sym_ht GT PLUS      &sym_ht LT MINUS     &std_under_emdash_ht 0 UNDER &trans            &kp DOWN               &std_under_emdash_ht 0 UNDER &sym_ht LT MINUS       &sym_ht GT PLUS      &kp EQUAL                 &kp DQT              &sym_ht PIPE PRCNT
                                                                        &trans               &trans               &kp SPC                                                               &kp ENTER                    &trans                 &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // Слой 23: Копия цифрового слоя, которая перенаправляет Backspace на новые стандартные символы (Слой 22)
        numbnolight_std_layer {
            display-name = "numbnolight_std_layer";
            bindings = <
&kp C_AL_CALCULATOR   &kp KP_MULTIPLY                  &kp N9  &kp N8  &kp N7  &kp KP_PLUS                                            &msc SCRL_UP                      &kp KP_PLUS     &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY                  &kp C_AL_CALCULATOR
&kp BSPC              &kp N0                           &kp N6  &kp N5  &kp N4  &kp KP_MINUS                          &msc SCRL_LEFT   &mkp LCLK       &msc SCRL_RIGHT   &kp KP_MINUS    &kp N4  &kp N5  &kp N6  &kp N0                           &bspc_to_layer_ht 22 BSPC
&kp KP_ENTER          &div_lshft_ht LSHFT KP_DIVIDE    &kp N3  &kp N2  &kp N1  &kp KP_EQUAL    &trans                                 &msc SCRL_DOWN                    &kp KP_EQUAL    &kp N1  &kp N2  &kp N3  &div_lshft_ht LSHFT KP_DIVIDE    &kp KP_ENTER
                                                               &trans  &trans  &trans                                                                                   &kp ENTER       &trans  &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };
    };
};