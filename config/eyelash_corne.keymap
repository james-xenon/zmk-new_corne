        // Держим hold более предпочтительным, чтобы слои точно включались удержанием.
        symb_win_td: symb_win_td {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&symb_win_tap_dance>;
        };

        symb_win_tap_dance: symb_win_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
