#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
};

&mmv {
};

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&kp LEFT_GUI>;

            label = "NEW_BEHAVIOR";
        };

        Gaming_5_3: Gaming_5_3 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&mo 5>, <&mo 3>;

            label = "GAMING_5_3";
        };

        lang_switch: lang_switch {
            compatible = "zmk,behavior-macro";
            label = "LANG_SWITCH";
            #binding-cells = <0>;
            tap-ms = <60>;
            wait-ms = <60>;
            bindings =
                <&macro_press &kp LALT>,
                <&macro_tap &kp LSHFT>,
                <&macro_release &kp LALT>;
        };

        bs_nav_td: bs_nav_td {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Backslash / NAV Layer";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp BSLH>, <&tog 7>;

            label = "BS_NAV_TD";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        Backspace_try {
            bindings = <&kp BACKSPACE>;
            key-positions = <24 23>;
        };

        Delete_try {
            bindings = <&kp DEL>;
            key-positions = <24 25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E          &kp R  &kp T                                &kp UP                &kp Y        &kp U  &kp I               &kp O    &kp P     &bs_nav_td
&td0       &kp A  &kp S  &kp D          &kp F  &kp G                      &kp LEFT  &kp ENTER  &kp RIGHT  &kp H        &kp J  &kp K               &kp L    &kp SEMI  &mt LSHFT SQT
&kp LCTRL  &kp Z  &kp X  &kp C          &kp V  &kp B        &kp C_MUTE              &kp DOWN              &kp N        &kp M  &kp COMMA           &kp DOT  &kp FSLH  &kp ESC
                         &new_behavior  &mo 1  &lt 3 SPACE                                                &lt 7 ENTER  &mo 2  &lang_switch
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&kp ESC  &kp N1           &kp N2          &kp N3           &kp N4           &kp N5                                   &msc SCRL_UP             &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans   &trans           &bt BT_SEL 0    &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3                   &kp HOME  &mkp LCLK       &kp END  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans   &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &kp C_MUTE              &msc SCRL_DOWN           &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                          &trans           &trans           &trans                                                            &kp BACKSPACE    &kp DEL          &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH  &kp DLLR  &kp PRCNT                            &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &kp SLASH     &none         &none     &none     &none                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none     &none     &none      &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans    &trans    &kp SPACE                                                             &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock  &kp F1             &kp F2  &kp F3      &kp F4  &kp F5                           &mmv MOVE_UP                     &kp F6         &kp F7      &kp F8       &kp F9  &kp F10          &kp F11
&trans          &ext_power EP_OFF  &none   &none       &none   &none            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &trans         &none       &none        &none   &kp PRINTSCREEN  &kp F12
&trans          &trans             &trans  &trans      &trans  &none   &to 4                    &mmv MOVE_DOWN                   &trans         &trans      &trans       &trans  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                           &sys_reset  &trans  &trans                                                            &kp BACKSPACE  &kp DELETE  &bootloader
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Gaming {
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E       &kp R  &kp T                         &kp UP               &kp Y    &kp U   &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LSHFT  &kp A  &kp S  &kp D       &kp F  &kp G               &kp LEFT  &trans    &kp RIGHT  &kp H    &kp J   &kp K      &kp L    &kp SEMI  &trans
&kp LCTRL  &kp Z  &kp X  &kp C       &kp V  &kp B      &to 0              &kp DOWN             &kp N    &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                         &lt 6 LALT  &mo 5  &kp SPACE                                          &kp RET  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Gaming-nums {
            bindings = <
&kp ESC  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                    &trans          &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &trans
&kp U    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0            &trans  &trans  &trans  &kp F8  &trans  &trans  &trans  &trans  &trans
&kp K    &kp L   &kp P   &kp J   &kp I   &kp M   &trans            &trans          &trans  &trans  &trans  &trans  &trans  &trans
                         &trans  &trans  &trans                                    &trans  &trans  &trans
            >;
        };

        layer_7 {
            display-name = "NAV";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans  &trans  &trans     &trans    &trans     &tog 7
&trans  &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &trans  &trans  &trans     &kp UP    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans           &trans          &trans  &trans  &kp LEFT   &kp DOWN   &kp RIGHT  &trans
                        &trans  &trans  &trans                                   &trans  &trans   &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans        &trans     &trans          &trans                             &trans          &trans          &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans           &trans
&trans  &trans          &mkp LCLK     &mkp MCLK  &mkp RCLK       &trans                     &trans  &trans  &trans  &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &trans
&trans  &msc SCRL_LEFT  &msc SCRL_UP  &trans     &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans            &trans          &msc SCRL_LEFT  &msc SCRL_DOWN  &mkp MCLK       &msc SCRL_UP     &msc SCRL_RIGHT  &trans
                                      &trans     &trans          &trans                                             &trans          &trans          &trans
            >;
        };
    };
};
