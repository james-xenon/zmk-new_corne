            tapping-term-ms = <200>;
            bindings = <&macro_degree_uni>, <&macro_comma_uni>;
        };
        semi_rbrc_ht: semi_rbrc_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
