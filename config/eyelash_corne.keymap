#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/ws2812_widget.dtsi>
#include <behaviors/ws2812_layer_sync.dtsi>
#include <behaviors/ws2812_activity_sync.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/rgb_timer.dtsi>
#include <behaviors/sleep_source.dtsi>
#include <behaviors/sleep_all.dtsi>

// --- НАСТРОЙКИ ОБОРУДОВАНИЯ И ПЕРИФЕРИИ ---
// Количество адресованных светодиодов WS2812 на одной половине сплит-клавиатуры
&led_strip {
    chain-length = <21>;
};

// Базовые параметры скорости перемещения курсора мыши и скролла:
// Увеличение чувствительности курсора (x2) и стандартный скролл (x1)
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };
// Настройки поведения прокрутки мыши (колесо):
// Мгновенный отклик, нулевая задержка и отсутствие кривой ускорения
&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

// Настройки поведения курсора мыши (эмуляция перемещения указателя):
// Плавный разгон до максимальной скорости за 500 мс, линейное ускорение;
// trigger-period-ms = 16 задаёт период повторной генерации движения.
&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};
/ {
    chosen {
        zmk,ws2812-widget = &led_strip;
    };

    // Soft Off: разрешить пробуждение любой клавишей матрицы.
    // kscan0 уже имеет wakeup-source в eyelash_corne.dtsi.
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan0>;
    };

    // --- ПОВЕДЕНИЯ КЛАВИШ (BEHAVIORS) ---
    behaviors {
        // ============================================================
        // CAPS LOCK + ИНДИКАЦИЯ НА LED 5,6 (БЕЗ СЛОЯ-ФЛАГА)
        // ============================================================
        caps_toggle: caps_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp CAPS>;
        };
        // ============================================================
        // ИСТОРИЧЕСКИЕ МАКРОСЫ ws2812_eff_*
        // ============================================================
        ws2812_eff_next: ws2812_eff_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 6>;
        };
        ws2812_eff_prev: ws2812_eff_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 7>;
        };
        ws2812_eff_off: ws2812_eff_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 8>;
        };
        rgb_timer: rgbtmr {
            compatible = "zmk,behavior-rgb-timer";
            #binding-cells = <1>;
        };
        rgb_timeout_up: rgb_timeout_up {
            compatible = "zmk,behavior-rgb-timeout";
            #binding-cells = <1>;
        };
        rgb_timeout_down: rgb_timeout_down {
            compatible = "zmk,behavior-rgb-timeout";
            #binding-cells = <1>;
        };
        macro_combo_rt: macro_combo_rt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp R>, <&macro_tap &kp T>;
        };
        combo_rt_caps_td: combo_rt_caps_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <450>;
            bindings = <&macro_combo_rt>, <&caps_toggle>;
        };
        // ============================================================
        // КОНЕЦ БЛОКА CAPS LOCK ПОДСВЕТКИ
        // ============================================================
        macro_dot_uni: macro_dot_uni {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press &kp LALT>,
                <&macro_tap &kp KP_N0>,
                <&macro_tap &kp KP_N4>,
                <&macro_tap &kp KP_N6>,
                <&macro_release &kp LALT>;
