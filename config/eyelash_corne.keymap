#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/ws2812_widget.dtsi>
#include <behaviors/ws2812_layer_sync.dtsi>
#include <behaviors/ws2812_activity_sync.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/rgb_timer.dtsi>
#include <behaviors/sleep_source.dtsi>
#include <behaviors/sleep_all.dtsi>

// ============================================================
// ФИНАЛЬНАЯ НУМЕРАЦИЯ СЛОЁВ
//
// Индекс 3 отдан под SYMB_ENG_LAYER, потому что именно старый
// индекс 3 у тебя уже даёт постоянный циан. Это позволяет получить
// постоянный циан для H + правый большой палец, не трогая widget.c.
//
// 0  — BASE
// 1  — KP_MODE
//
// 2  — SYMB_LAYER: русские символы Alt, persistent
// 3  — SYMB_ENG_LAYER: английские символы без Alt, persistent, циан
// 4  — NUMB_LAYER: русские цифры Alt, persistent
//
// 5  — NUMB_NOLIGHT_LAYER
// 6  — SYMB_NOLIGHT_LAYER
// 7  — NUMB_NOLIGHT_COPY_LAYER
//
// 8  — NUMB_ENG_NOLIGHT_LAYER
// 9  — SYMB_ENG_NOLIGHT_LAYER
//
// 10 — FN
// 11 — SERVICE
//
// 12 — NAV1
// 13 — NAV2
// 14 — NAV2_NOLIGHT
// 15 — NAV3
//
// 16 — GAMING1
// 17 — GAMING2
// 18 — GAMING3
//
// 19 — SPEEDTYPE
//
// 20 — LEFTHAND
// 21 — LEFTHAND_NOLIGHT
// ============================================================

#define BASE_LAYER                    0
#define KP_MODE_LAYER                 1

#define SYMB_LAYER                    2
#define SYMB_ENG_LAYER                3
#define NUMB_LAYER                    4

#define NUMB_NOLIGHT_LAYER            5
#define SYMB_NOLIGHT_LAYER            6
#define NUMB_NOLIGHT_COPY_LAYER       7

#define NUMB_ENG_NOLIGHT_LAYER        8
#define SYMB_ENG_NOLIGHT_LAYER        9

#define FN_LAYER                      10
#define SERVICE_LAYER                 11

#define NAV1_LAYER                    12
#define NAV2_LAYER                    13
#define NAV2_NOLIGHT_LAYER            14
#define NAV3_LAYER                    15

#define GAMING1_LAYER                 16
#define GAMING2_LAYER                 17
#define GAMING3_LAYER                 18

#define SPEEDTYPE_LAYER               19

#define LEFTHAND_LAYER                20
#define LEFTHAND_NOLIGHT_LAYER        21

// --- НАСТРОЙКИ ОБОРУДОВАНИЯ И ПЕРИФЕРИИ ---
&led_strip {
    chain-length = <21>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    chosen {
        zmk,ws2812-widget = &led_strip;
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan0>;
    };

    behaviors {
        caps_toggle: caps_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings = <&kp CAPS>;
        };

        ws2812_eff_next: ws2812_eff_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 6>;
        };

        ws2812_eff_prev: ws2812_eff_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 7>;
        };

        ws2812_eff_off: ws2812_eff_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&ws2812_wdg 8>;
        };

        rgb_timer_custom: rgbtimer_custom {
            compatible = "zmk,behavior-rgb-timer";
            #binding-cells = <1>;
        };

        rgb_timeout_up: rgb_timeout_up {
            compatible = "zmk,behavior-rgb-timeout";
            #binding-cells = <1>;
        };

        rgb_timeout_down: rgb_timeout_down {
            compatible = "zmk,behavior-rgb-timeout";
            #binding-cells = <1>;
        };

        macro_combo_rt: macro_combo_rt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp R>, <&macro_tap &kp T>;
        };

        combo_rt_caps_td: combo_rt_caps_td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <450>;
            bindings = <&macro_combo_rt>, <&caps_toggle>;
        };

        macro_dot_uni: macro_dot_uni {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings =
                <&macro_press &kp LALT>,
                <&macro_tap &kp KP_N0>,
                <&macro_tap &kp KP_N4>,
                <&macro_tap &kp KP_N6>,
                <&macro_release &kp LALT>;
        };

