    // --- КОМБИНАЦИИ КЛАВИШ (COMBOS) ---
    combos {
        compatible = "zmk,combos";
        
        combo_rt_caps {
            timeout-ms = <80>;
            require-prior-idle-ms = <150>;
            key-positions = <4 5>;
